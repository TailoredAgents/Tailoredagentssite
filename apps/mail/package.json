{
  "name": "tailored-agents-mail",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/wrap-cloudflare-worker.mjs",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "test": "tsx --test src/lib/*.test.ts src/lib/**/*.test.ts tests/*.test.ts",
    "test:browser": "tsx scripts/seed-local-test.ts && playwright test",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "recover-owner": "tsx scripts/recover-owner.ts",
    "test:seed": "tsx scripts/seed-local-test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "~8.1.6",
    "wrangler": "^4.151.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.58.0",
    "@types/sanitize-html": "^2.16.0",
    "miniflare": "5.20261012.0-beta"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "postal-mime": "^4.1.4",
    "qrcode": "^1.5.4",
    "remixicon": "^4.9.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "sanitize-html": "^2.17.0",
    "image-size": "2.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "undici": "^7.30.1"
  }
}
