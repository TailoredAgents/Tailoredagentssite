{
  "name": "tailored-agents-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "oxlint app components lib scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run lib",
    "db:migrate": "node scripts/migrate.mjs",
    "db:retention": "node scripts/retention.mjs",
    "search-console:sync": "node scripts/trigger-search-console-sync.mjs",
    "mail:dev": "npm --prefix apps/mail run dev",
    "mail:check": "npm --prefix apps/mail run check",
    "mail:test": "npm --prefix apps/mail test",
    "mail:build": "npm --prefix apps/mail run build",
    "dashboard:provision": "node scripts/provision-dashboard-user.mjs",
    "test:browser": "playwright test",
    "test:inbox:browser": "playwright test --config playwright.inbox.config.ts",
    "test:sms:browser": "playwright test --config playwright.sms.config.ts",
    "test:conversations:browser": "playwright test --config playwright.conversations.config.ts",
    "test:voice:browser": "playwright test --config playwright.voice.config.ts",
    "test:design:browser": "playwright test --config playwright.design.config.ts",
    "test:integration": "vitest run lib/reporting/database.integration.test.ts",
    "reporting:preview": "node scripts/start-reporting-preview.mjs",
    "test:recovery": "node scripts/test-reporting-recovery.mjs",
    "seo:worker": "node --conditions=react-server --import tsx scripts/run-seo-worker.ts",
    "test:seo:browser": "playwright test --config playwright.seo.config.ts",
    "test:meta:browser": "playwright test --config playwright.meta.config.ts",
    "test:factory:browser": "playwright test --config playwright.factory.config.ts",
    "factory:worker": "node --conditions=react-server --import tsx scripts/run-factory-worker.ts",
    "seo:pilot": "node --conditions=react-server --import tsx scripts/run-seo-pilot.ts",
    "factory:build-worker": "node --conditions=react-server --import tsx scripts/run-factory-build-worker.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@twilio/voice-sdk": "^2.18.5",
    "better-auth": "^1.7.10",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "parse5": "8.0.1",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "4.23.15",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "oxlint": "1.87.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
