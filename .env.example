# Public canonical site URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.tailoredagents.com

# Optional inquiry notifications. These values do not control dashboard login.
# Public inquiries are stored in PostgreSQL without these values.
# Create an API key and verified sender at resend.com when ready.
RESEND_API_KEY=re_placeholder
CONTACT_FROM_EMAIL=Tailored Agents Website <website@your-verified-domain.com>
# One address or comma-separated team addresses (up to 10).
CONTACT_TO_EMAIL=your-inbox@example.com

# Meta website measurement and Facebook/Instagram Instant Form lead intake.
# See docs/META_SETUP.md. NEXT_PUBLIC values require a new website build.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ENABLED=false
META_PAGE_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Generate a separate random value (at least 32 characters), shared with the webhook setup.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Signed webhook receipts still queue while importing is paused.
META_LEADS_ENABLED=false

# Private dashboard. The public website remains available when these are absent.
# Use a persistent PostgreSQL instance before storing real business records.
DATABASE_URL=postgresql://user:password@host:5432/database
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
BETTER_AUTH_URL=http://localhost:3000
# Production uses the existing Tailored Mail password and owner-approved access.
# Set to mail only after installing the matching DASHBOARD_AUTH_SECRET in Mail.
DASHBOARD_AUTH_MODE=password
MAIL_AUTH_URL=https://mail.tailoredagents.com/api/dashboard-auth
MAIL_AUTH_SECRET=
# Optional live CRM Inbox. Set the SAME CRM_MAIL_SECRET on the website (Render)
# and Mail (Cloudflare); use a new high-entropy value of at least 32 characters.
# It must differ from MAIL_AUTH_SECRET / Mail's DASHBOARD_AUTH_SECRET.
# This capability does not grant mailbox access: a Mail owner must separately
# approve sales@tailoredagents.com for Devon, Jeffrey and Austin's confirmed
# Mail accounts. See docs/COMMUNICATIONS_SETUP.md. Empty means Inbox setup state.
CRM_MAIL_SECRET=
# Optional business SMS. All values stay on the website server (Render).
# REST requests use a dedicated API key; the account Auth Token validates webhooks.
# Set the account and existing owned number only after ownership/capability checks.
# See docs/COMMUNICATIONS_SETUP.md for activation and registration checks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Exact true enables outbound SMS only after explicit number and teammate grants.
# Keep false during setup. Signed incoming STOP/status callbacks still work while paused.
TWILIO_SMS_ENABLED=false
# Optional browser calling uses the same verified account/API key and number.
# Create a TwiML App with the outbound URL in docs/VOICE_SETUP.md.
TWILIO_VOICE_APP_SID=
# Keep false until voice line grants, routing and owner-led acceptance are ready.
TWILIO_VOICE_ENABLED=false
# Call analysis runs only on the server, through the existing scheduled worker.
OPENAI_API_KEY=
CALL_ANALYSIS_ENABLED=false
# These two legacy settings are only required in password mode (local previews).
DASHBOARD_ALLOWED_EMAILS=owner@tailoredagents.com

# At least 10 characters. Used to create the first owner account on first login.
DASHBOARD_INITIAL_PASSWORD=replace-with-your-private-dashboard-password

# Optional Google Search Console connection. Create a Web application OAuth client
# with this exact redirect URI:
# http://localhost:3000/api/integrations/search-console/callback
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# At least 32 high-entropy characters. Used only by the protected scheduled-sync endpoint.
SEARCH_CONSOLE_SYNC_SECRET=replace-with-at-least-32-high-entropy-characters

# Internal SEO manager. Reuses OPENAI_API_KEY above; never expose these publicly.
# See docs/SEO_MANAGER_SETUP.md. The manager starts paused with a $40/month limit.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Protects the optional one-stage HTTP trigger. The separate cron uses DATABASE_URL.
SEO_WORKER_SECRET=
