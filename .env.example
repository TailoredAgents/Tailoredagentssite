# Public canonical site URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tailoredagents.com

# Contact delivery. Create an API key and verified sender at resend.com.
RESEND_API_KEY=re_placeholder
CONTACT_FROM_EMAIL=Tailored Agents Website <website@your-verified-domain.com>
CONTACT_TO_EMAIL=your-inbox@example.com

# Optional: comma-separated proxy IPs that are allowed to set forwarded headers.
# Leave empty unless your hosting architecture requires custom handling.
TRUSTED_PROXY_IPS=

# Private dashboard. The public website remains available when these are absent.
# Use a persistent PostgreSQL instance before storing real business records.
DATABASE_URL=postgresql://user:password@host:5432/database
BETTER_AUTH_SECRET=replace-with-at-least-32-high-entropy-characters
BETTER_AUTH_URL=http://localhost:3000
DASHBOARD_ALLOWED_EMAILS=owner@tailoredagents.com

# Optional. Falls back to CONTACT_FROM_EMAIL when omitted.
DASHBOARD_FROM_EMAIL=Tailored Agents Dashboard <dashboard@your-verified-domain.com>
